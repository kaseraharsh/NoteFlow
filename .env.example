# Port to run the server on (default 3000)
PORT=3000

# Optional: Google Gemini API Key (get free key from https://aistudio.google.com/app/apikey)
# If left blank, the app will use its Smart Built-in Engine with 0 external dependencies!
GEMINI_API_KEY=

# Optional: Groq API Key (get free key from https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=
